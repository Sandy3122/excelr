# ─── Google Sheets (service account) — optional ────────────────────
# Create a service account in Google Cloud, enable the Google Sheets API,
# then SHARE the target spreadsheet with GOOGLE_SERVICE_ACCOUNT_EMAIL as Editor.
# Leave blank to skip Sheets and only send email.
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the full private key. Keep the \n sequences escaped on a single line;
# they are converted back to newlines at runtime.
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Optional: sheet/tab name to append to (defaults to "Registrations")
GOOGLE_SHEETS_SHEET_NAME=Registrations

# ─── SMTP (SparkPost / Nodemailer) — required for form submit ──────
# Host smtp.sparkpostmail.com · port 587 or 2525 · STARTTLS · AUTH LOGIN
# Username is always SMTP_Injection. From address MUST use placements.excelr.in.
SMTP_HOST=smtp.sparkpostmail.com
SMTP_PORT=587
SMTP_USER=SMTP_Injection
SMTP_PASS=your_sparkpost_smtp_password_here
SMTP_FROM="ExcelR Placement Team <noreply@placements.excelr.in>"
# Inbox that receives the admin notification for each registration
REG_NOTIFY_TO=excelrelearning@gmail.com

# Set to "true" to send the confirmation email (public/reg/index.html) to the applicant
REG_SEND_APPLICANT_CONFIRMATION=true

# ─── Infobip WhatsApp OTP (server-side only) ───────────────────────
# NEVER expose these to the client. Do NOT use NEXT_PUBLIC_ prefixes.
INFOBIP_API_KEY=
INFOBIP_ACCOUNT_KEY=
INFOBIP_TEMPLATE_ID=884804994387290
INFOBIP_TEMPLATE_NAME=fsd_website_otp_11082026
INFOBIP_CONFIRMATION_TEMPLATE_ID=2283037602514705
INFOBIP_CONFIRMATION_TEMPLATE_NAME=fsd_placement_drive_confirmation_message_a
INFOBIP_WHATSAPP_SENDER=918050162541
INFOBIP_TEMPLATE_LANGUAGE=en_IN
# Your Infobip base URL, e.g. https://xxxxx.api.infobip.com (from the Infobip dashboard).
INFOBIP_BASE_URL=
# Dynamic URL-button suffix. "otp" (default) sends the generated OTP.
INFOBIP_TEMPLATE_URL_BUTTON_PARAM=otp

# ─── WhatsApp OTP behaviour ────────────────────────────────────────
WHATSAPP_OTP_EXPIRY_SECONDS=300
WHATSAPP_OTP_RESEND_COOLDOWN_SECONDS=60
WHATSAPP_OTP_MAX_ATTEMPTS=5
WHATSAPP_OTP_MAX_SENDS_PER_HOUR=5
WHATSAPP_OTP_MAX_SENDS_PER_IP_PER_HOUR=20
WHATSAPP_OTP_VERIFIED_TTL_SECONDS=900
WHATSAPP_OTP_DEFAULT_COUNTRY=IN
# Secret used to HMAC OTPs before storage. Set to a long random string.
WHATSAPP_OTP_HASH_SECRET=

# ─── OTP storage (Redis) ───────────────────────────────────────────
# Native Redis connection string (redis:// or rediss://). When set, OTPs are
# stored durably in Redis. If unset, an in-memory store is used (local dev only).
REDIS_URL=
# Optional alternative: Upstash REST API (https:// URL + REST token). Leave
# blank when using REDIS_URL above.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
